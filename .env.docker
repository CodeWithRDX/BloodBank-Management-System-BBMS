# ══════════════════════════════════════════════════════════════════════════════
# BBMS — Docker Environment Template
# Copy this to .env and fill in your values before running docker compose.
#
#   cp .env.docker .env
#
# WARNING: Never commit .env to version control.
# ══════════════════════════════════════════════════════════════════════════════

# ── Host Ports ─────────────────────────────────────────────────────────────────
HTTP_PORT=80                    # Nginx reverse proxy host port
MONGO_PORT=27017                # MongoDB host port (dev only — not exposed in prod)
SERVER_PORT=5000                # Direct server port (dev only)
CLIENT_PORT=5173                # Vite dev server port (dev only)
MONGO_EXPRESS_PORT=8081         # Mongo Express UI port (dev --profile tools only)

# ── MongoDB ─────────────────────────────────────────────────────────────────────
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=change_me_in_production
MONGO_DB=bloodbank
MONGO_APP_PASSWORD=change_me_app_password

# ── JWT ─────────────────────────────────────────────────────────────────────────
# Generate a strong secret: openssl rand -base64 64
JWT_SECRET=change_me_to_a_very_long_random_string_in_production
JWT_EXPIRE=7d
JWT_COOKIE_EXPIRE=7

# ── Client / CORS ───────────────────────────────────────────────────────────────
CLIENT_URL=http://bbms.raushan.live,https://bbms.raushan.live

# ── Email (Nodemailer) ──────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password
FROM_EMAIL=noreply@bbms.com
FROM_NAME=BBMS

# ── File Upload ─────────────────────────────────────────────────────────────────
MAX_FILE_SIZE=5242880           # 5 MB in bytes

# ── Mongo Express (DB admin UI — start with: make db-admin) ─────────────────
MONGO_EXPRESS_USER=bbms_admin
MONGO_EXPRESS_PASS=change_me_express_password
MONGO_EXPRESS_PORT=8081
