# Dependencies (Ignore packages in root and subdirectories)
node_modules/

# Environment configurations (Contains sensitive secrets and credentials)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.*.local
.env.docker.local

# Build outputs
dist/
dist-ssr/
build/
bin/
out/

# Log files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Uploads & Static assets (Exclude user-uploaded uploads from source control)
server/uploads/*
!server/uploads/.gitkeep

# Testing and Code Coverage reports
coverage/
.nyc_output/

# OS / System generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# IDE and Editor configuration directories
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
*.swo

# Docker / Container local/temp files
.docker/
docker-compose.override.yml
