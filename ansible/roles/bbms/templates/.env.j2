# ──────────────────────────────────────────────────────────────────────────────
# Production Environment Variables for BBMS Server
# Generated securely by Ansible
# ──────────────────────────────────────────────────────────────────────────────

NODE_ENV={{ app_env | default('production') }}
PORT={{ backend_port | default(5000) }}

# MongoDB Connection
MONGO_URI={{ vault_mongo_uri | default('mongodb://127.0.0.1:27017/bloodbank') }}

# JWT Authentication
JWT_SECRET={{ vault_jwt_secret | default('default_insecure_jwt_change_in_vault') }}
JWT_EXPIRE={{ vault_jwt_expire | default('7d') }}
JWT_COOKIE_EXPIRE={{ vault_jwt_cookie_expire | default(7) }}

# Nodemailer SMTP Email Config
SMTP_HOST={{ vault_smtp_host | default('smtp.gmail.com') }}
SMTP_PORT={{ vault_smtp_port | default(587) }}
SMTP_USER={{ vault_smtp_user | default('') }}
SMTP_PASS={{ vault_smtp_pass | default('') }}
FROM_EMAIL={{ vault_from_email | default('noreply@bbms.org') }}
FROM_NAME={{ vault_from_name | default('BBMS System') }}

# CORS Allowed Origins
CLIENT_URL={{ client_url | default('http://localhost') }}

# Uploads Configuration
MAX_FILE_SIZE=5242880

# ImageKit (Optional Cloud storage fallback)
IMAGEKIT_PUBLIC_KEY={{ vault_imagekit_public_key | default('') }}
IMAGEKIT_PRIVATE_KEY={{ vault_imagekit_private_key | default('') }}
IMAGEKIT_URL_ENDPOINT={{ vault_imagekit_url_endpoint | default('') }}

# Telegram Bot (Optional Notification Bridge)
TELEGRAM_BOT_TOKEN={{ vault_telegram_bot_token | default('') }}

